{
  "name": "maintenance-union",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-account.mjs create",
    "admin:password": "node --env-file-if-exists=.env scripts/admin-account.mjs password",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "db:role": "node --env-file-if-exists=.env scripts/provision-role.mjs",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "check:deployment": "node --env-file-if-exists=.env scripts/check-deployment.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "restore:logos": "node --env-file-if-exists=.env scripts/restore-logos.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.16.3",
    "pngjs": "7.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "type": "module",
  "displayName": "اتحاد الصيانة - اربد"
}
